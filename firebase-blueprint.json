{
  "entities": {
    "WarehouseMeta": {
      "title": "WarehouseMeta",
      "description": "Metadata status sinkronisasi cloud gudang SIMAG PLN.",
      "type": "object",
      "properties": {
        "initialized": { "type": "boolean", "description": "Menandakan apakah gudang cloud sudah terinisialisasi." },
        "resetVersion": { "type": "number", "description": "Versi reset gudang untuk sinkronisasi reset antar perangkat." },
        "ownerUid": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$", "description": "UID pemilik pembuat dokumen awal." },
        "workspaceId": { "type": "string", "maxLength": 64, "pattern": "^[a-zA-Z0-9_\\-]+$", "description": "ID workspace bersama SIMAG PLN ULP Baguala." },
        "updatedBy": { "type": "string", "maxLength": 120, "description": "NIP atau nama operator terakhir." },
        "serverCreatedAt": { "type": "string", "format": "date-time", "description": "Timestamp pembuatan di server." },
        "serverUpdatedAt": { "type": "string", "format": "date-time", "description": "Timestamp pembaruan terakhir di server." }
      },
      "required": ["initialized", "resetVersion", "ownerUid", "serverCreatedAt", "serverUpdatedAt"]
    },
    "WarehouseRack": {
      "title": "WarehouseRack",
      "description": "Data rak gudang beserta konfigurasi tingkat dan daftar karton.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 64, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "name": { "type": "string", "maxLength": 120 },
        "zone": { "type": "string", "maxLength": 120 },
        "primaryBrand": { "type": "string", "maxLength": 100 },
        "brandColor": { "type": "string", "maxLength": 32 },
        "shelves": { "type": "array", "description": "Daftar 4 tingkat rak beserta ID karton." },
        "ownerUid": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "workspaceId": { "type": "string", "maxLength": 64, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "serverCreatedAt": { "type": "string", "format": "date-time" },
        "serverUpdatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "name", "zone", "primaryBrand", "shelves", "ownerUid", "serverCreatedAt", "serverUpdatedAt"]
    },
    "InboundCarton": {
      "title": "InboundCarton",
      "description": "Data karton penerimaan material kWh meter yang tersimpan di rak.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "cartonBarcode": { "type": "string", "maxLength": 128 },
        "brand": { "type": "string", "maxLength": 100 },
        "phase": { "type": "string", "enum": ["1 Phasa", "3 Phasa"] },
        "category": { "type": "string", "maxLength": 80 },
        "unitsCount": { "type": "number" },
        "meterSerials": { "type": "array", "description": "Daftar SN kWh meter dalam karton." },
        "rackId": { "type": "string", "maxLength": 64 },
        "shelfLevel": { "type": "number" },
        "dateInbound": { "type": "string", "maxLength": 64 },
        "receivedBy": { "type": "string", "maxLength": 120 },
        "notes": { "type": "string", "maxLength": 500 },
        "ownerUid": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "workspaceId": { "type": "string", "maxLength": 64, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "serverCreatedAt": { "type": "string", "format": "date-time" },
        "serverUpdatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "id",
        "cartonBarcode",
        "brand",
        "phase",
        "category",
        "unitsCount",
        "meterSerials",
        "rackId",
        "shelfLevel",
        "dateInbound",
        "receivedBy",
        "ownerUid",
        "serverCreatedAt",
        "serverUpdatedAt"
      ]
    },
    "MeterUnit": {
      "title": "MeterUnit",
      "description": "Unit kWh meter individual beserta nomor seri dan status ketersediaannya.",
      "type": "object",
      "properties": {
        "serialNumber": { "type": "string", "maxLength": 128 },
        "brand": { "type": "string", "maxLength": 100 },
        "phase": { "type": "string", "enum": ["1 Phasa", "3 Phasa"] },
        "category": { "type": "string", "maxLength": 80 },
        "cartonBarcode": { "type": "string", "maxLength": 128 },
        "rackId": { "type": "string", "maxLength": 64 },
        "shelfLevel": { "type": "number" },
        "dateInbound": { "type": "string", "maxLength": 64 },
        "status": { "type": "string", "enum": ["AVAILABLE", "DISPATCHED", "QUARANTINE"] },
        "dispatchId": { "type": "string", "maxLength": 128 },
        "ownerUid": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "workspaceId": { "type": "string", "maxLength": 64, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "serverCreatedAt": { "type": "string", "format": "date-time" },
        "serverUpdatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "serialNumber",
        "brand",
        "phase",
        "category",
        "cartonBarcode",
        "rackId",
        "shelfLevel",
        "dateInbound",
        "status",
        "ownerUid",
        "serverCreatedAt",
        "serverUpdatedAt"
      ]
    },
    "OutboundRecord": {
      "title": "OutboundRecord",
      "description": "Riwayat transaksi pengeluaran material Pasang Baru (PB) dan Ganti Meter (GM).",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "tanggal": { "type": "string", "maxLength": 64 },
        "jenisTransaksi": { "type": "string", "enum": ["PB", "GM"] },
        "idPelanggan": { "type": "string", "maxLength": 64 },
        "noMeter": { "type": "string", "maxLength": 128 },
        "nomorAgenda": { "type": "string", "maxLength": 128 },
        "nama": { "type": "string", "maxLength": 160 },
        "tarif": { "type": "string", "maxLength": 32 },
        "daya": { "type": "number" },
        "snKwhMeter": { "type": "string", "maxLength": 128 },
        "snMcb": { "type": "string", "maxLength": 128 },
        "segel": { "type": "string", "maxLength": 128 },
        "kabelTw": { "type": "number" },
        "petugas": { "type": "string", "maxLength": 120 },
        "gmKategori": { "type": "string", "maxLength": 64 },
        "gmKeterangan": { "type": "string", "maxLength": 500 },
        "noMeterLama": { "type": "string", "maxLength": 128 },
        "standMeterLama": { "type": "string", "maxLength": 64 },
        "snSegelLama": { "type": "string", "maxLength": 128 },
        "meterBrand": { "type": "string", "maxLength": 100 },
        "meterCategory": { "type": "string", "maxLength": 80 },
        "rackSource": { "type": "string", "maxLength": 120 },
        "ownerUid": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "workspaceId": { "type": "string", "maxLength": 64, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "serverCreatedAt": { "type": "string", "format": "date-time" },
        "serverUpdatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "id",
        "tanggal",
        "jenisTransaksi",
        "idPelanggan",
        "noMeter",
        "nomorAgenda",
        "nama",
        "tarif",
        "daya",
        "snKwhMeter",
        "snMcb",
        "segel",
        "kabelTw",
        "petugas",
        "ownerUid",
        "serverCreatedAt",
        "serverUpdatedAt"
      ]
    },
    "SimagUserAccount": {
      "title": "SimagUserAccount",
      "description": "Akun NIP operator SIMAG PLN beserta hash password dan peran akses.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "nip": { "type": "string", "maxLength": 32 },
        "nama": { "type": "string", "maxLength": 120 },
        "role": { "type": "string", "enum": ["Administrator", "Kepala Gudang", "Petugas Gudang", "Operator"] },
        "passwordHash": { "type": "string", "maxLength": 128 },
        "createdAt": { "type": "string", "maxLength": 64 },
        "updatedAt": { "type": "string", "maxLength": 64 },
        "lastLoginAt": { "type": "string", "maxLength": 64 },
        "ownerUid": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "workspaceId": { "type": "string", "maxLength": 64, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "serverCreatedAt": { "type": "string", "format": "date-time" },
        "serverUpdatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "id",
        "nip",
        "nama",
        "role",
        "passwordHash",
        "createdAt",
        "updatedAt",
        "ownerUid",
        "serverCreatedAt",
        "serverUpdatedAt"
      ]
    }
  },
  "firestore": {
    "/warehouse_meta/{docId}": {
      "schema": { "$ref": "#/entities/WarehouseMeta" },
      "description": "Dokumen status inisialisasi dan versi sinkronisasi gudang."
    },
    "/warehouse_racks/{rackId}": {
      "schema": { "$ref": "#/entities/WarehouseRack" },
      "description": "Koleksi rak gudang dan posisi karton pada tiap tingkat."
    },
    "/warehouse_cartons/{cartonId}": {
      "schema": { "$ref": "#/entities/InboundCarton" },
      "description": "Koleksi karton material kWh meter yang masuk ke gudang."
    },
    "/warehouse_meters/{meterId}": {
      "schema": { "$ref": "#/entities/MeterUnit" },
      "description": "Koleksi unit kWh meter individual."
    },
    "/warehouse_outbounds/{outboundId}": {
      "schema": { "$ref": "#/entities/OutboundRecord" },
      "description": "Koleksi catatan pengeluaran material PB dan GM."
    },
    "/simag_users/{userId}": {
      "schema": { "$ref": "#/entities/SimagUserAccount" },
      "description": "Koleksi akun login NIP SIMAG PLN yang tersinkron antar perangkat."
    }
  }
}
